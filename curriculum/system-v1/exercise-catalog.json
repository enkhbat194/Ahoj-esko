{
  "schema_version": "1.0.0",
  "status": "CATALOGUE_AND_DRAFT_LESSON_RENDERER_CONTRACT_NO_APP_DEPLOY",
  "lesson_length_minutes_recommendation": [
    12,
    18
  ],
  "core_exercises_per_learning_session_recommendation": [
    7,
    9
  ],
  "range_is_trial": true,
  "pedagogical_stage_relation": "Original 15 stages are pedagogical FUNCTIONS, NOT 15 separate compulsory on-screen cards. A 7–9-exercise session can cover stages by mapping them to exercises and feedback/review actions; missing audio stages remain blocked, not counted as fulfilled.",
  "selection_rules": {
    "new_lexemes_typical": [
      4,
      6
    ],
    "new_lexemes_minimum": 0,
    "new_lexemes_maximum_for_a0_first_pass": 6,
    "mandatory": [
      "context_hook",
      "word_card",
      "meaning_match",
      "guided_dialogue",
      "novel_transfer"
    ],
    "choose_additionally": [
      "sentence_reorder",
      "cloze",
      "listen_choose",
      "listen_repeat",
      "spoken_roleplay"
    ],
    "add_due_reviews_separately": "review at session entry/exit as learner data allows; not counted as new vocabulary",
    "constraints": [
      "never reward visual tapping as mastery of speaking",
      "novel transfer hidden during lesson until test",
      "do not use future unintroduced words without contextual scaffold",
      "word_card is short exposure not a complete lesson",
      "a single scenario measures at most one main can-do with supplementary skills"
    ]
  },
  "stage_coverage_profile": {
    "S01": "context_hook",
    "S02": "listen_choose",
    "S03": "context_hook,meaning_match",
    "S04": "listen_repeat",
