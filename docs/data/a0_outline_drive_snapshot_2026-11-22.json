  "entries": [
    {
      "id": "A0-T01-L01",
      "title_mn": "Чех үсгийг сонсож таних"
    },
    {
      "id": "A0-T01-L02",
      "title_mn": "Суурь эгшгийг ялгах"
    },
    {
      "id": "A0-T01-L03",
      "title_mn": "Урт ба богино эгшгийг ялгах"
    },
    {
      "id": "A0-T01-L04",
      "title_mn": "Č, Š, Ž авиаг таних"
    },
    {
      "id": "A0-T01-L05",
      "title_mn": "C/Č, S/Š, Z/Ž авиаг сонсож ялгах"
    },
    {
      "id": "A0-T01-L06",
      "title_mn": "Ď, Ť, Ň-ийг сонсож хэлэх"
    },
    {
      "id": "A0-T01-L07",
      "title_mn": "R ба Ř-г таньж дуудах"
    },
    {
      "id": "A0-T01-L08",
      "title_mn": "Танил бус үг унших сорил"
    },
    {
      "id": "A0-T02-L01",
      "title_mn": "Сайн уу, баяртай"
    },
    {
      "id": "A0-T02-L02",
      "title_mn": "Би Эба байна"
    },
    {
      "id": "A0-T02-L03",
      "title_mn": "Сайн уу, ямар байна?"
    },
    {
      "id": "A0-T02-L04",
      "title_mn": "Би сайн, муугүй байна"
    },
    {
      "id": "A0-T02-L05",
      "title_mn": "Тийм ээ, үгүй ээ"
    },
    {
      "id": "A0-T02-L06",
      "title_mn": "Энэ бол Сара"
    },
    {
      "id": "A0-T02-L07",
      "title_mn": "Тэр эрэгтэй, тэр эмэгтэй"
    },
    {
      "id": "A0-T02-L08",
      "title_mn": "Тэр ч бас сайн байна"
    },
    {
      "id": "A0-T02-L09",
      "title_mn": "Чи, Та гэж хүндэтгэх"
    },
    {
      "id": "A0-T02-L10",
      "title_mn": "Чиний нэр хэн бэ?"
    },
    {
      "id": "A0-T02-L11",
      "title_mn": "Миний нэр, түүний нэр"
    },
    {
      "id": "A0-T02-L12",
      "title_mn": "Хэн бэ? Танилцъя"
    },
    {
      "id": "A0-T02-L13",
      "title_mn": "Энэ бол миний найз, багш"
    },
    {
      "id": "A0-T02-L14",
      "title_mn": "Түүний найз, түүний багш"
    },
    {
      "id": "A0-T02-L15",
      "title_mn": "Баярлалаа, маш их баярлалаа"
    },
    {
      "id": "A0-T02-L16",
      "title_mn": "Уучлаарай"
    },
    {
      "id": "A0-T02-L17",
      "title_mn": "Гуйя, туслаач"
    },
    {
      "id": "A0-T02-L18",
      "title_mn": "Мэндчилгээний бие даасан сорил"
    },
    {
      "id": "A0-T03-L01",
      "title_mn": "Би ойлгохгүй байна"
    },
    {
      "id": "A0-T03-L02",
      "title_mn": "Уучлаарай, юу гэлээ?"
    },
    {
      "id": "A0-T03-L03",
      "title_mn": "Дахин хэлж өгнө үү"
    },
    {
      "id": "A0-T03-L04",
      "title_mn": "Удаан хэлж өгнө үү"
    },
    {
      "id": "A0-T03-L05",
      "title_mn": "Хүндэтгэлтэй давтан хэлүүлэх"
    },
    {
      "id": "A0-T03-L06",
      "title_mn": "Энэ ямар утгатай вэ?"
    },
    {
      "id": "A0-T03-L07",
      "title_mn": "Үүнийг чехээр юу гэдэг вэ?"
    },
    {
      "id": "A0-T03-L08",
      "title_mn": "Яриаг таслахгүй үргэлжлүүлэх сорил"
    },
    {
      "id": "A0-T04-L01",
      "title_mn": "Тэгээс арав хүртэл хэлэх"
    },
    {
      "id": "A0-T04-L02",
      "title_mn": "Арван нэгээс хорь хүртэл хэлэх"
    },
    {
      "id": "A0-T04-L03",
      "title_mn": "Аравтуудыг сонсож ялгах"
    },
    {
      "id": "A0-T04-L04",
      "title_mn": "Зуу хүртэл тоо хэлэх"
    },
    {
      "id": "A0-T04-L05",
      "title_mn": "Утасны дугаар хэлэх"
    },
    {
      "id": "A0-T04-L06",
      "title_mn": "Үнийг сонсож ойлгох"
    },
    {
      "id": "A0-T04-L07",
      "title_mn": "Энэ хэд вэ гэж асуух"
    },
    {
      "id": "A0-T04-L08",
      "title_mn": "Касс дээр төлбөр хийх сорил"
    },
    {
      "id": "A0-T05-L01",
      "title_mn": "Өнөөдөр, маргааш, өчигдөр"
    },
    {
      "id": "A0-T05-L02",
      "title_mn": "Долоо хоногийн өдрүүд"
    },
    {
      "id": "A0-T05-L03",
      "title_mn": "Өглөө, өдөр, орой"
    },
    {
      "id": "A0-T05-L04",
      "title_mn": "Бүтэн цагийг хэлэх"
    },
    {
      "id": "A0-T05-L05",
      "title_mn": "Хэдэн цагт гэж асуух"
    },
    {
      "id": "A0-T05-L06",
      "title_mn": "Хэзээ гэж асуух"
    },
    {
      "id": "A0-T05-L07",
      "title_mn": "Уулзах цаг санал болгох"
    },
    {
      "id": "A0-T05-L08",
      "title_mn": "Уулзалтын цаг батлах сорил"
    },
    {
      "id": "A0-T06-L01",
      "title_mn": "Ээж, аавыг танилцуулах"
    },
    {
      "id": "A0-T06-L02",
      "title_mn": "Эцэг эх, гэр бүл"
    },
    {
      "id": "A0-T06-L03",
      "title_mn": "Эхнэр, нөхрөө танилцуулах"
    },
    {
      "id": "A0-T06-L04",
      "title_mn": "Хүү, охиноо хэлэх"
    },
    {
      "id": "A0-T06-L05",
      "title_mn": "Ах, эгч, дүүгээ хэлэх"
    },
    {
      "id": "A0-T06-L06",
      "title_mn": "Миний гэдгийг хэлэх"
    },
    {
      "id": "A0-T06-L07",
      "title_mn": "Түүний гэдгийг хэлэх"
    },
    {
      "id": "A0-T06-L08",
      "title_mn": "Гэр бүлийн танилцуулгын сорил"
    },
    {
      "id": "A0-T07-L01",
      "title_mn": "Ус, кофе, талх зэрэг зүйлс"
    },
    {
      "id": "A0-T07-L02",
      "title_mn": "Би үүнийг авъя"
    },
    {
      "id": "A0-T07-L03",
      "title_mn": "Нэг, хоёр ширхэг хүсэх"
    },
    {
      "id": "A0-T07-L04",
      "title_mn": "Өлсөж, цангаснаа хэлэх"
    },
    {
      "id": "A0-T07-L05",
      "title_mn": "Кафед ундаа захиалах"
    },
    {
      "id": "A0-T07-L06",
      "title_mn": "Цэсээс хоол сонгох"
    },
    {
      "id": "A0-T07-L07",
      "title_mn": "Дэлгүүрээс бараа асуух"
    },
    {
      "id": "A0-T07-L08",
      "title_mn": "Үнэ лавлах"
    },
    {
      "id": "A0-T07-L09",
      "title_mn": "Тоо хэмжээ батлах"
    },
    {
      "id": "A0-T07-L10",
      "title_mn": "Кафе ба дэлгүүрийн сорил"
    },
    {
      "id": "A0-T08-L01",
      "title_mn": "Буудал хаана вэ?"
    },
    {
      "id": "A0-T08-L02",
      "title_mn": "Энд, тэнд гэж хэлэх"
    },
    {
      "id": "A0-T08-L03",
      "title_mn": "Баруун, зүүн ялгах"
    },
    {
      "id": "A0-T08-L04",
      "title_mn": "Шулуун явах заавар"
    },
    {
      "id": "A0-T08-L05",
      "title_mn": "Автобус, трамвай, метро"
    },
    {
      "id": "A0-T08-L06",
      "title_mn": "Очих буудлаа олох"
    },
    {
      "id": "A0-T08-L07",
      "title_mn": "Тасалбар асуух"
    },
    {
      "id": "A0-T08-L08",
      "title_mn": "Хэдэн цагт явахыг асуух"
    },
    {
      "id": "A0-T08-L09",
      "title_mn": "Төөрсөн үед зам олох сорил"
    },
    {
      "id": "A0-T09-L01",
      "title_mn": "Ажил мэргэжлээ хэлэх"
    },
    {
      "id": "A0-T09-L02",
      "title_mn": "Энгийн багаж нэрлэх"
    },
    {
      "id": "A0-T09-L03",
      "title_mn": "Энэ юу вэ?"
    },
    {
      "id": "A0-T09-L04",
      "title_mn": "Багаж хүсэх"
    },
    {
      "id": "A0-T09-L05",
      "title_mn": "Энд, тэнд гэсэн байрлал"
    },
    {
      "id": "A0-T09-L06",
      "title_mn": "Хий, бүү хий гэсэн заавар"
    },
    {
      "id": "A0-T09-L07",
      "title_mn": "Зогс гэсэн дохиог ойлгох"
    },
    {
      "id": "A0-T09-L08",
      "title_mn": "Аюулын анхааруулга таних"
    },
    {
      "id": "A0-T09-L09",
      "title_mn": "Ойлгоогүй зааврыг давтуулах"
    },
    {
      "id": "A0-T09-L10",
      "title_mn": "Ажил дээр тусламж хүсэх сорил"
    },
    {
      "id": "A0-T10-L01",
      "title_mn": "Биеийн үндсэн хэсгүүд"
    },
    {
      "id": "A0-T10-L02",
      "title_mn": "Миний бие өвдөж байна"
    },
    {
      "id": "A0-T10-L03",
      "title_mn": "Хаана өвдөж байгааг хэлэх"
    },
    {
      "id": "A0-T10-L04",
      "title_mn": "Сайн, муу байгаагаа хэлэх"
    },
    {
      "id": "A0-T10-L05",
      "title_mn": "Эмч хэрэгтэй гэж хэлэх"
    },
    {
      "id": "A0-T10-L06",
      "title_mn": "Эмийн сан асуух"
    },
    {
      "id": "A0-T10-L07",
      "title_mn": "Тусламж хэрэгтэй гэж хэлэх"
    },
    {
      "id": "A0-T10-L08",
      "title_mn": "Энгийн шинж тэмдэг хэлэх"
    },
    {
      "id": "A0-T10-L09",
      "title_mn": "Ойлгоогүй үед лавлах"
    },
    {
      "id": "A0-T10-L10",
      "title_mn": "Эмчтэй богино харилцах сорил"
    },
    {
      "id": "A0-T11-L01",
      "title_mn": "Байр, байшингаа танилцуулах"
    },
    {
      "id": "A0-T11-L02",
      "title_mn": "Өрөөнүүдийг нэрлэх"
    },
    {
      "id": "A0-T11-L03",
      "title_mn": "Хаалга, цонх, эд зүйл"
    },
    {
      "id": "A0-T11-L04",
      "title_mn": "Гэрт байгаа зүйлс"
    },
    {
      "id": "A0-T11-L05",
      "title_mn": "Энэ хаана байна?"
    },
    {
      "id": "A0-T11-L06",
      "title_mn": "Энд, тэнд, байхгүй"
    },
    {
      "id": "A0-T11-L07",
      "title_mn": "Эвдэрсэн зүйлээ хэлэх"
    },
    {
      "id": "A0-T11-L08",
      "title_mn": "Хаягаа хэлэх сорил"
    },
    {
      "id": "A0-T12-L01",
      "title_mn": "Үндсэн өнгийг сонсож ялгах"
    },
    {
      "id": "A0-T12-L02",
      "title_mn": "Өнгийг нэрлэн сонгох"
    },
    {
      "id": "A0-T12-L03",
      "title_mn": "Том, жижиг гэж хэлэх"
    },
    {
      "id": "A0-T12-L04",
      "title_mn": "Дугуй хэлбэр таних"
    },
    {
      "id": "A0-T12-L05",
      "title_mn": "Дөрвөлжин хэлбэр таних"
    },
    {
      "id": "A0-T12-L06",
      "title_mn": "Өнгө, эд зүйлийг хамт хэлэх"
    },
    {
      "id": "A0-T12-L07",
      "title_mn": "Зөв эд зүйлийг сонгох сорил"
    },
    {
      "id": "A0-T13-L01",
      "title_mn": "Хувцасны үндсэн нэр"
    },
    {
      "id": "A0-T13-L02",
      "title_mn": "Хувцасны өнгө"
    },
    {
      "id": "A0-T13-L03",
      "title_mn": "Хэмжээ асуух"
    },
    {
      "id": "A0-T13-L04",
      "title_mn": "Хүссэн зүйлээ хэлэх"
    },
    {
      "id": "A0-T13-L05",
      "title_mn": "Өмсөж үзэхийг хүсэх"
    },
    {
      "id": "A0-T13-L06",
      "title_mn": "Том, жижиг гэж хэлэх"
    },
    {
      "id": "A0-T13-L07",
      "title_mn": "Өөр хэмжээ хүсэх"
    },
    {
      "id": "A0-T13-L08",
      "title_mn": "Дэлгүүрт хувцас авах сорил"
    },
    {
      "id": "A0-T14-L01",
      "title_mn": "Халуун, хүйтнийг хэлэх"
    },
    {
      "id": "A0-T14-L02",
      "title_mn": "Бороо орж байна"
    },
    {
      "id": "A0-T14-L03",
      "title_mn": "Цас орж байна"
    },
    {
      "id": "A0-T14-L04",
      "title_mn": "Салхитай байна"
    },
    {
      "id": "A0-T14-L05",
      "title_mn": "Өнөөдрийн цаг агаар"
    },
    {
      "id": "A0-T14-L06",
      "title_mn": "Маргаашийн цаг агаар"
    },
    {
      "id": "A0-T14-L07",
      "title_mn": "Цаг агаарын богино ярианы сорил"
    },
    {
      "id": "A0-T15-L01",
      "title_mn": "Багш, сурагчийг таних"
    },
    {
      "id": "A0-T15-L02",
      "title_mn": "Ном, дэвтэр, үзэг"
    },
    {
      "id": "A0-T15-L03",
      "title_mn": "Нээ, хаа, сонс гэсэн заавар"
    },
    {
      "id": "A0-T15-L04",
      "title_mn": "Ойлгосон эсэхээ хэлэх"
    },
    {
      "id": "A0-T15-L05",
      "title_mn": "Багшаас асуулт асуух"
    },
    {
      "id": "A0-T15-L06",
      "title_mn": "Дахин тайлбарлуулах"
    },
    {
      "id": "A0-T15-L07",
      "title_mn": "Хичээлийн харилцааны сорил"
    },
    {
      "id": "A0-T16-L01",
      "title_mn": "Нохой, муур, шувууг нэрлэх"
    },
    {
      "id": "A0-T16-L02",
      "title_mn": "Энэ юу вэ?"
    },
    {
      "id": "A0-T16-L03",
      "title_mn": "Амьтны өнгө"
    },
    {
      "id": "A0-T16-L04",
      "title_mn": "Том, жижиг амьтан"
    },
    {
      "id": "A0-T16-L05",
      "title_mn": "Миний тэжээвэр амьтан"
    },
    {
      "id": "A0-T16-L06",
      "title_mn": "Амьтны тухай богино ярианы сорил"
    }
  ]
}
